{
  "name": "@mergehez/barke",
  "version": "0.1.4",
  "description": "an automation utilities library for deployment or anything you want!",
  "homepage": "https://github.com/mergehez/barke",
  "license": "MIT",
  "author": "mergehez <argesozdogan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergehez/barke.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./ts": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build.mjs",
    "publishx": "npm version patch && bun run build && npm publish --access=public && bun run install-global",
    "install-global": "npm cache clean --force && npm i -g @mergehez/barke && npm list -g && bun add --global @mergehez/barke --force",
    "test-ts": "bun run build && bun barke-test-unix.ts --dry-run"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.3",
    "node-ssh": "^13.2.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/ssh2": "^1.15.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
